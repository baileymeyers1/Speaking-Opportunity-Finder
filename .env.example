# Database (Postgres everywhere; Prisma 7 reads this through prisma.config.ts)
# Local development: `docker compose up -d db` starts postgres:16 on port 5433
# with the databases speaking_finder (dev) and speaking_finder_test (vitest).
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/speaking_finder"
# Server tests push the schema into this database before running; override when
# your Postgres lives elsewhere.
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/speaking_finder_test"

# JWT Authentication
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Server
PORT=3001
NODE_ENV=development

# CORS (frontend URL)
CORS_ORIGIN=http://localhost:5173

# Client
VITE_API_URL=http://localhost:3001/api

# Auto-sync (fetch new opportunities periodically; spends Linkup credits)
ENABLE_AUTO_SYNC=false

# Linkup Search API (https://linkup.so) for live search and CFP discovery
# Sign up at https://app.linkup.so to get an API key
WEB_SEARCH_API_KEY=

# Anthropic API key for enrichment, verification and live-search extraction
ANTHROPIC_API_KEY=
