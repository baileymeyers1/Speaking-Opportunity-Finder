generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String             @id @default(uuid())
  email               String             @unique
  passwordHash        String
  preferredIndustries String             @default("[]")
  isAdmin             Boolean            @default(false)
  createdAt           DateTime           @default(now())
  savedOpportunities  SavedOpportunity[]
}

model Opportunity {
  id                  String             @id @default(uuid())
  title               String
  organization        String
  description         String?
  location            String?
  isRemote            Boolean            @default(false)
  eventDate           DateTime?
  cfpDeadline         DateTime?
  format              String
  industries          String             @default("[]")
  compensationType    String?
  compensationAmount  Int?
  compensationDetails String?
  applyUrl            String             @unique
  qualityScore        Int?
  source              String
  sourceUrl           String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  enrichmentStatus    String?
  enrichedAt          DateTime?
  enrichmentError     String?
  savedBy             SavedOpportunity[]

  @@index([cfpDeadline])
  @@index([eventDate])
  @@index([qualityScore])
  @@index([format])
  @@index([source])
  @@index([createdAt])
  @@index([isRemote])
  @@index([compensationType])
  @@index([enrichmentStatus])
}

model SavedOpportunity {
  id            String      @id @default(uuid())
  userId        String
  opportunityId String
  category      String      @default("interested")
  createdAt     DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([userId, opportunityId])
}
