generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String             @id @default(uuid())
  email               String             @unique
  passwordHash        String
  preferredIndustries String             @default("[]")
  isAdmin             Boolean            @default(false)
  resetToken          String?
  resetTokenExpires   DateTime?
  createdAt           DateTime           @default(now())
  savedOpportunities  SavedOpportunity[]
  savedSearches       SavedSearch[]
  speakerProfile      SpeakerProfile?
}

model Opportunity {
  id                  String             @id @default(uuid())
  title               String
  organization        String
  description         String?
  location            String?
  isRemote            Boolean            @default(false)
  eventDate           DateTime?
  cfpDeadline         DateTime?
  format              String
  industries          String             @default("[]")
  compensationType    String?
  compensationAmount  Int?
  compensationDetails String?
  applyUrl            String             @unique
  qualityScore        Int?
  source              String
  sourceUrl           String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  enrichmentStatus    String?
  enrichedAt          DateTime?
  enrichmentError     String?
  enrichmentAttempts  Int                @default(0)
  enrichmentClaimedAt DateTime?
  isClosed            Boolean            @default(false)
  isRelevant          Boolean            @default(true)
  verifiedAt          DateTime?
  verificationError   String?
  dateConfidence      String?
  savedBy             SavedOpportunity[]

  @@index([cfpDeadline])
  @@index([eventDate])
  @@index([qualityScore])
  @@index([format])
  @@index([source])
  @@index([createdAt])
  @@index([isRemote])
  @@index([compensationType])
  @@index([enrichmentStatus])
  @@index([source, createdAt])
  @@index([enrichmentStatus, createdAt])
  @@index([cfpDeadline, source])
  @@index([isClosed, isRelevant])
  @@index([enrichmentStatus, enrichmentAttempts, enrichmentClaimedAt])
  @@index([verifiedAt])
  @@index([cfpDeadline, verifiedAt])
}

model SavedOpportunity {
  id            String      @id @default(uuid())
  userId        String
  opportunityId String
  category      String      @default("interested")
  createdAt     DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([userId, opportunityId])
}

model SavedSearch {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  query     String?
  filters   String   // JSON: { industries: [], locations: [], types: [], sort: '', isRemote: bool, ... }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Daily Claude enrichment budget, keyed by UTC date (YYYY-MM-DD).
// Lives in the DB so the cap survives serverless cold starts.
model EnrichmentUsage {
  date      String   @id
  count     Int      @default(0)
  updatedAt DateTime @updatedAt
}

// One row per scraper execution, for observability and for rotating
// coverage when a sync runs under a time budget (least recently run first).
model ScraperRun {
  id         String    @id @default(uuid())
  scraper    String
  cadence    String
  status     String // running | ok | error
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  found      Int       @default(0)
  added      Int       @default(0)
  updated    Int       @default(0)
  error      String?

  @@index([scraper, startedAt])
}

// One row per live search, so frequent queries can be promoted into the
// scheduled Linkup slice and the admin dashboard can show what people look for.
model SearchLog {
  id          String   @id @default(uuid())
  query       String
  industries  String   @default("[]")
  locations   String   @default("[]")
  resultCount Int      @default(0)
  userId      String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([query])
}

// One per user: what the speaker talks about, where they will go and what
// they need to be paid. Read by the deterministic match score
// (server/src/services/matchScore.ts); never by any scraper.
model SpeakerProfile {
  id                      String   @id @default(uuid())
  userId                  String   @unique
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topics                  String   @default("[]") // JSON array of free-text tags stored as string
  bio                     String   @default("")
  seniority               String   @default("experienced") // new | experienced | keynote
  homeCity                String?
  homeCountry             String?
  travelRadius            String   @default("international") // local | country | international
  remotePreference        String   @default("either") // remote_only | prefer_remote | either | prefer_in_person
  compensationRequirement String   @default("any") // any | travel_covered | paid
  preferredFormats        String   @default("[]") // JSON array of OpportunityFormat stored as string
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}
