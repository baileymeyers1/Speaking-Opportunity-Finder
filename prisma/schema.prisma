generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                  String             @id @default(uuid())
  email               String             @unique
  passwordHash        String
  preferredIndustries String             @default("[]") // JSON array stored as string
  isAdmin             Boolean            @default(false)
  resetToken          String?
  resetTokenExpires   DateTime?
  createdAt           DateTime           @default(now())
  savedOpportunities  SavedOpportunity[]
  savedSearches       SavedSearch[]
}

model Opportunity {
  id                  String             @id @default(uuid())
  title               String
  organization        String
  description         String?
  location            String?
  isRemote            Boolean            @default(false)
  eventDate           DateTime?
  cfpDeadline         DateTime?
  format              String             // conference, meetup, podcast, etc.
  industries          String             @default("[]") // JSON array stored as string
  compensationType    String?            // paid, travel, exposure
  compensationAmount  Int?               // Amount in USD (for range filtering)
  compensationDetails String?
  applyUrl            String             @unique
  qualityScore        Int?               // 0-100 heuristic score
  source              String
  sourceUrl           String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  enrichmentStatus    String?            // 'enriched' | 'failed' | 'skipped' | null
  enrichedAt          DateTime?
  enrichmentError     String?
  savedBy             SavedOpportunity[]

  @@index([cfpDeadline])
  @@index([eventDate])
  @@index([qualityScore])
  @@index([format])
  @@index([source])
  @@index([createdAt])
  @@index([isRemote])
  @@index([enrichmentStatus])
  @@index([source, createdAt])
  @@index([enrichmentStatus, createdAt])
  @@index([cfpDeadline, source])
}

model SavedOpportunity {
  id            String      @id @default(uuid())
  userId        String
  opportunityId String
  category      String      @default("interested")
  createdAt     DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id])
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])

  @@unique([userId, opportunityId])
}

model SavedSearch {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  name      String
  query     String?
  filters   String   // JSON: { industries: [], locations: [], types: [], sort: '', isRemote: bool, ... }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}
